      "parameters": {
        "jsCode": "\nconst getOrganicData = (nodeName) => {\n  try {\n    const results = $(nodeName).all();\n    return results.flatMap(item => item.json.organic || []);\n  } catch (e) {\n    return [];\n  }\n};\n\nconst nfaResults = getOrganicData('NFA');\nconst bisaResults = getOrganicData('BISA AI');\nconst vinixResults = getOrganicData('Vinix 7');\n\nconst currentTime = DateTime.now().toFormat('yyyy-MM-dd HH:mm');\n\nconst finalData = [\n  ...nfaResults.map(i => ({\n    json: { ...i, brand: 'NF Academy', processedAt: currentTime }\n  })),\n  ...bisaResults.map(i => ({\n    json: { ...i, brand: 'BISA AI', processedAt: currentTime }\n  })),\n  ...vinixResults.map(i => ({\n    json: { ...i, brand: 'Vinix 7', processedAt: currentTime }\n  }))\n];\n\nreturn finalData;\n"
      },
